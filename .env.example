# No credentials here. Generate secrets with python3 scripts/init.py.
# Starting Minecraft accepts its EULA; set TRUE only after reading it.
EULA=FALSE
# All-in-one default: administration and the isolated player app.
# Leave empty to start only the Minecraft service.
COMPOSE_PROFILES=admin
JAVA_PORT=25565
BEDROCK_PORT=19132
PANEL_TRUSTED_HOSTS=localhost,127.0.0.1
# Linux: stat -c %g /var/run/docker.sock; macOS Docker Desktop often uses 0.
DOCKER_SOCKET_GID=0
